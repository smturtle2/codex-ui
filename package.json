{
  "name": "codex-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "node ./scripts/up.mjs",
    "dev": "node --import tsx server/index.ts",
    "legacy-bridge": "node --import tsx server/legacy-bridge.ts",
    "build": "node ./node_modules/next/dist/bin/next build",
    "refresh:runtime-assets": "node ./scripts/refresh-runtime-assets.mjs",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "funnel": "bash ./scripts/tailscale-funnel.sh up 3000",
    "funnel:status": "bash ./scripts/tailscale-funnel.sh status",
    "funnel:off": "bash ./scripts/tailscale-funnel.sh down",
    "test": "node --import tsx --test src/lib/windows-terminal.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
